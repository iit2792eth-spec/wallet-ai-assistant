# Only source goes into git. Everything below is local data, a secret, or
# something a command regenerates (named next to each entry).

# --- Dependencies (npm install) -------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build output (npm run dev / npm run build) ----------------------------
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# --- Local runtime data: never commit ---------------------------------------
# Database (contains the model API keys), audit log, encrypted keystore.
# Recreated from db/schema.sql on first start.
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
keystore.json
*.log

# --- Secrets -----------------------------------------------------------------
.env*
!.env.example
*.pem
*.key

# --- Model weights (too large for git; regenerated by training/export) -----
# Exported ONNX classifier: sh scripts/classifier/export-onnx.sh
/models/
# Fine-tuned weights (~720 MB each): the notebooks next to them retrain them.
# The notebooks and reports/ stay in git.
/synthetic_plus_crai/model/
/v2_data_fix/model/
*.onnx
*.onnx_data
*.safetensors
*.ckpt
*.pt
*.pth
training_args.bin

# --- Generated test output (npm test / npm run test:live) -------------------
/coverage
/results/
# Classifier sweep outputs, if run from the repo root (see docs/Injection_Classifier.md)
/scores*.json
/scores*.csv
/sweep.json

# --- Python (scripts/classifier, notebooks) ---------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- Editors, OS and local tool settings ------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.claude/settings.local.json

# --- Debug logs and deploy ----------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
